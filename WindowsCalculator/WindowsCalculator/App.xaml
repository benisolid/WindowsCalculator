<Application x:Class="WindowsCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#17191F"/>
    <SolidColorBrush x:Key="PanelBg" Color="#22252D"/>
    <SolidColorBrush x:Key="ButtonBg" Color="#2D313B"/>
    <SolidColorBrush x:Key="Accent" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="TextMain" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A8AFBC"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Background" Value="{StaticResource ButtonBg}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>

<Window x:Class="WindowsCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Calculator" Height="650" Width="420"
        MinHeight="580" MinWidth="360"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextMain}"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="2,0,2,14">
      <TextBlock Text="CALCULATOR" Foreground="{StaticResource TextMuted}"
                 FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Content="History" FontSize="13" Padding="12,7" Margin="0"
              HorizontalAlignment="Right" Click="History_Click"/>
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="14"
            Padding="18" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="ExpressionText" Text="" Foreground="{StaticResource TextMuted}"
                   FontSize="16" TextAlignment="Right" MinHeight="24"/>
        <TextBlock x:Name="DisplayText" Text="0" FontSize="42" FontWeight="Light"
                   TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/><RowDefinition Height="*"/>
        <RowDefinition Height="*"/><RowDefinition Height="*"/>
        <RowDefinition Height="*"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Row="0" Grid.Column="0" Content="AC" Click="Clear_Click"/>
      <Button Grid.Row="0" Grid.Column="1" Content="±" Click="Sign_Click"/>
      <Button Grid.Row="0" Grid.Column="2" Content="%" Click="Percent_Click"/>
      <Button Grid.Row="0" Grid.Column="3" Content="÷" Background="{StaticResource Accent}" Click="Operator_Click"/>

      <Button Grid.Row="1" Grid.Column="0" Content="7" Click="Digit_Click"/>
      <Button Grid.Row="1" Grid.Column="1" Content="8" Click="Digit_Click"/>
      <Button Grid.Row="1" Grid.Column="2" Content="9" Click="Digit_Click"/>
      <Button Grid.Row="1" Grid.Column="3" Content="×" Background="{StaticResource Accent}" Click="Operator_Click"/>

      <Button Grid.Row="2" Grid.Column="0" Content="4" Click="Digit_Click"/>
      <Button Grid.Row="2" Grid.Column="1" Content="5" Click="Digit_Click"/>
      <Button Grid.Row="2" Grid.Column="2" Content="6" Click="Digit_Click"/>
      <Button Grid.Row="2" Grid.Column="3" Content="−" Background="{StaticResource Accent}" Click="Operator_Click"/>

      <Button Grid.Row="3" Grid.Column="0" Content="1" Click="Digit_Click"/>
      <Button Grid.Row="3" Grid.Column="1" Content="2" Click="Digit_Click"/>
      <Button Grid.Row="3" Grid.Column="2" Content="3" Click="Digit_Click"/>
      <Button Grid.Row="3" Grid.Column="3" Content="+" Background="{StaticResource Accent}" Click="Operator_Click"/>

      <Button Grid.Row="4" Grid.Column="0" Content="√" Click="Sqrt_Click"/>
      <Button Grid.Row="4" Grid.Column="1" Content="x²" Click="Square_Click"/>
      <Button Grid.Row="4" Grid.Column="2" Content="0" Click="Digit_Click"/>
      <Button Grid.Row="4" Grid.Column="3" Content="=" Background="{StaticResource Accent}" Click="Equals_Click"/>

      <Button Grid.Row="5" Grid.Column="0" Content="⌫" Click="Backspace_Click"/>
      <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Content="." Click="Decimal_Click"/>
      <Button Grid.Row="5" Grid.Column="3" Content="C" Click="ClearEntry_Click"/>
    </Grid>
  </Grid>
</Window>
